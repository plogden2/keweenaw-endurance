FROM golang:1.25-alpine

RUN apk add --no-cache git ca-certificates tzdata gcc musl-dev

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN addgroup -g 1001 -S appuser && \
    adduser -S -u 1001 -G appuser appuser && \
    chown -R appuser:appuser /app

USER appuser

ENV GO_ENV=test

# Exclude Fyne GUI binaries (need Wayland/X11 headers not in this alpine image).
CMD ["sh", "-c", "go test $(go list ./... | grep -vE '/cmd/reader-gui$|/cmd/reader-setup$') -v -cover"]
